!/data/processed/reactivation_thresholds.csv
!/data/processed/repeat_purchase_summary.csv
!/data/processed/rfm_segments.csv
!/data/processed/rfm_sensitivity.csv
# Temporary downloads and local database state
/data/raw/uci-download-*/
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
# Local runtime, notebook, and editor artifacts
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.env.*
!.env.example
.vscode/
.idea/
.pytest_cache/
.coverage
.jupyter/
.DS_Store
Thumbs.db
~$*
